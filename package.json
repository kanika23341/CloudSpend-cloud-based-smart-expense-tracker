{
  "name": "cloudspend",
  "version": "1.0.0",
  "description": "Production-minded personal finance web application with local SQLite and 8 AWS service integrations",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "test": "node --test tests/*.test.js",
    "test:aws": "node scripts/test-aws-connection.js",
    "aws:setup": "node scripts/setup-aws-resources.js",
    "seed": "node scripts/init-sqlite.js --seed",
    "dynamo:init": "node scripts/init-dynamodb.js"
  },
  "keywords": [
    "personal-finance",
    "budget",
    "expenses",
    "express",
    "sqlite",
    "aws",
    "cognito",
    "dynamodb",
    "s3",
    "sns",
    "cloudwatch",
    "ssm",
    "lambda",
    "api-gateway"
  ],
  "author": "CloudSpend Engineering",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.1153.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1153.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1153.0",
    "@aws-sdk/client-dynamodb": "^3.1153.0",
    "@aws-sdk/client-lambda": "^3.1153.0",
    "@aws-sdk/client-s3": "^3.1153.0",
    "@aws-sdk/client-sns": "^3.1153.0",
    "@aws-sdk/client-ssm": "^3.1153.0",
    "@aws-sdk/client-sts": "^3.1153.0",
    "@aws-sdk/lib-dynamodb": "^3.1153.0",
    "@aws-sdk/s3-request-presigner": "^3.1153.0",
    "@vendia/serverless-express": "^4.12.6",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "supertest": "^7.3.1",
    "uuid": "^14.0.3"
  }
}
