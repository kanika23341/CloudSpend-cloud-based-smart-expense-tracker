# ==============================================================================
# CloudSpend Environment Configuration
# ==============================================================================

# Application Runtime
NODE_ENV=development
PORT=3000
APP_NAME=CloudSpend
APP_URL=http://localhost:3000

# Authentication Configuration
# AUTH_PROVIDER: 'local' (uses SQLite + bcrypt + JWT) or 'cognito' (uses AWS Cognito)
AUTH_PROVIDER=local
JWT_SECRET=replace-with-a-secure-random-secret-at-least-32-chars-long
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# Storage Mode
# STORAGE_MODE: 'sqlite' (local file db) or 'dynamodb' (AWS DynamoDB)
STORAGE_MODE=sqlite
SQLITE_DB_PATH=./data/cloudspend.db

# ==============================================================================
# AWS Services Configuration (Optional for Local Development)
# ==============================================================================
# Standard AWS credentials (leave blank for local mode or AWS IAM Role/SSO in cloud)
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# 1. AWS Cognito
# Required only if AUTH_PROVIDER=cognito
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=

# 2. AWS DynamoDB
# Required only if STORAGE_MODE=dynamodb
DYNAMODB_TABLE_NAME=CloudSpend-Main

# 3. AWS S3 (Receipt uploads & CSV exports)
# If empty, receipts are saved locally to public/uploads/
S3_BUCKET_NAME=
S3_PRESIGNED_URL_EXPIRES=900

# 4. AWS SNS (Budget alerts & notifications)
# If empty, notifications are logged to the console/system event log
SNS_TOPIC_ARN=

# 5. AWS CloudWatch (Custom application metrics & structured logs)
# If set to true, metrics (transactions, latency, budget breaches) are sent to CloudWatch
CLOUDWATCH_METRICS_ENABLED=false
CLOUDWATCH_NAMESPACE=CloudSpend/App
CLOUDWATCH_LOG_GROUP=/cloudspend/application

# 6. AWS Systems Manager (SSM) Parameter Store
# If true, loads configuration values dynamically from SSM Parameter Store path
SSM_CONFIG_ENABLED=false
SSM_PARAM_PREFIX=/cloudspend/config/

# 7. AWS Lambda (Asynchronous background report generation)
# Name or ARN of the async report generator Lambda function
ASYNC_REPORT_LAMBDA_NAME=CloudSpend-ReportWorker

# 8. API Gateway (Set to true automatically when running inside Lambda/API Gateway)
IS_SERVERLESS=false
