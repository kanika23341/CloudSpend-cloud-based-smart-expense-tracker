# Copy to .env (or set these in your hosting environment).
NODE_ENV=development
PORT=3000

# Required in production. Generate one with: openssl rand -hex 32
JWT_SECRET=

# SQLite file location. Point at a persistent volume when deployed.
DB_PATH=./data/cloudspend.db

# Defaults to true when NODE_ENV=production. Set to false only for plain-http testing.
# COOKIE_SECURE=true
